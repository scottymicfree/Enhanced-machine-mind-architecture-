Autonomous Coding Loop
export class AutonomousCodingLoop {
  async run(task: BuildTask): Promise<BuildResult> {
    const plan = await this.projectArchitect.createPlan(task);
    const graph = await this.repoManager.buildProjectGraph(task.projectPath);
    const edits = await this.codeGenerator.generateEdits(plan, graph);
    await this.repoManager.applyEdits(edits);
    const build = await this.buildRunner.run(graph);
    const tests = await this.testRunner.run(graph);

    if (!build.success || !tests.success) {
      const diagnosis = await this.errorInterpreter.diagnose(build, tests);
      return this.run({ ...task, previousDiagnosis: diagnosis });
    }

    const docs = await this.documentationWriter.write(graph, plan);
    const artifact = await this.packageExporter.package(graph);

    return { success: true, graph, docs, artifact };
  }
}
